# Copie para .env e preencha. As chaves sem default são obrigatórias: settings.py
# recusa iniciar e lista o que falta.
# Gere cada segredo com: python -c "import secrets; print(secrets.token_hex(32))"

# ── runtime ───────────────────────────────────────────────────────────────────
EXEC_MODE=dev                 # dev | prod  (DEBUG só vale em dev)
DEBUG=true
PORT=5000

# ── segredos (três valores DIFERENTES) ────────────────────────────────────────
# Sessões do Flask. Trocar só desloga todo mundo.
SECRET_KEY=
# Cifra os dados no banco. Trocar torna os dados existentes ilegíveis.
# Para um banco já populado, use aqui o valor do antigo `SecretKey`.
ENCRYPTION_KEY=
# Tokens da API usada pela extensão.
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ── banco ─────────────────────────────────────────────────────────────────────
# Obrigatório em prod. Em dev, sem valor, usa SQLite em instance/maindug.db.
# DATABASE_URL=postgresql://user:pass@localhost:5432/maindug

# ── rede ──────────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:5000
# Proxies que reescrevem X-Forwarded-For na frente da app (no Vercel é 1, automático).
# TRUSTED_PROXY_HOPS=0
# Limite de requisições por instância. Para limite global: redis://...
RATE_LIMIT_STORAGE=memory://

# ── primeiro admin (scripts/createAdmin.py) ───────────────────────────────────
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_PASSWORD=
